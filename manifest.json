{
  "manifest_version": 3,
  "name": "FreeCopy",
  "version": "1.0.1",
  "description": "Unblock text selection and copy on any website. Clean Copy, Plain Text mode, per-site control and keyboard shortcut.",
  "icons": {
    "16":  "icons/freecopy-icon16.png",
    "48":  "icons/freecopy-icon48.png",
    "128": "icons/freecopy-icon128.png"
  },
  "permissions": ["activeTab", "storage", "clipboardWrite", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/freecopy-icon16.png",
      "48":  "icons/freecopy-icon48.png",
      "128": "icons/freecopy-icon128.png"
    }
  },
  "commands": {
    "toggle-freecopy": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Toggle FreeCopy on/off for current site"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js":  ["content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["icons/*"],
    "matches": ["<all_urls>"]
  }]
}
